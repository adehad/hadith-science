---
import Page from "../layouts/Page.astro";
import Moon from "../components/svg/Moon.astro";
import { loadContent } from "../lib/content";
import { MAP_CENTRE, moonAt, orbitRadii, planetAt, planetRadius, startAngle } from "../lib/orbit";
import { href } from "../lib/url";

const { divisions, scenes } = await loadContent();
const scenesFor = (div: string, k: number) => scenes.filter((s) => s.division === div && s.moons.includes(k));
const [cx, cy] = MAP_CENTRE;
const fmt = (n: number) => +n.toFixed(2);
// Astro types <a> as the HTML element; inside an SVG it also takes SVG presentation attributes
const svgAttrs = (a: Record<string, string>) => a;
// positions are computed here so the map is complete without JavaScript; the orbit island moves them on
const planets = divisions.map((d, i) => {
  const a = startAngle(i), [x, y] = planetAt(i, a), r = planetRadius(d.moons.length);
  return { d, i, a, x: fmt(x), y: fmt(y), r, sats: d.moons.map((_, k) => moonAt(k, d.moons.length, r).map(fmt)) };
});
---
<Page
  title="Map of the book · Nuzhat al-Naẓar, visualised"
  description="Ibn Ḥajar al-ʿAsqalānī’s eight divisions of the hadith sciences, drawn as planets circling the Prophet ﷺ."
  crumbs={[{ label: "Map", path: "" }]}
>
  <div>
    <div class="eyebrow">The whole book · Ibn Ḥajar’s divisions</div>
    <h1>Map of the book</h1>
    <p class="lede">Each planet is one of Ibn Ḥajar’s divisions, in his order, circling the Prophet ﷺ as the source. Its moons are the sub-divisions under it. Choose a planet to open its page.</p>
  </div>
  <div class="stage">
    <svg class="map" viewBox="0 90 820 400" role="group" aria-label="Eight planets for Ibn Ḥajar’s divisions orbiting a full moon">
      {planets.map(({ i }) => {
        const [rx, ry] = orbitRadii(i);
        return <ellipse class="orbit" cx={cx} cy={cy} rx={rx} ry={ry} />;
      })}
      <Moon cx={cx} cy={cy} k={1.3} />
      {planets.map(({ d, i, a, x, y, r, sats }) => (
        <a
          href={href(`${d.id}/`)}
          class="planet"
          aria-label={`${d.term}: ${d.en}`}
          data-i={i}
          data-angle={a.toFixed(3)}
          {...svgAttrs({ transform: `translate(${x} ${y})` })}
        >
          <circle class="pbody" r={r} style={`fill:var(--p${d.order})`} />
          {sats.map(([sx, sy]) => <circle class="sat" r="3" cx={sx} cy={sy} />)}
          <text class="ptitle" y={r + 20}>{d.term}</text>{" "}
          <text class="psub" y={r + 34}>{d.en}</text>
        </a>
      ))}
    </svg>
  </div>
  <!-- portrait phones: the same divisions as a nested list rooted at the moon, instead of a cramped orbit map -->
  <div class="tree">
    <div class="root" aria-hidden="true"><svg viewBox="0 0 80 80"><Moon cx={40} cy={40} k={0.9} /></svg></div>
    <ol aria-label="Ibn Ḥajar’s eight divisions, in his order">
      {divisions.map((d) => (
        <li>
          <a href={href(`${d.id}/`)} class="div">
            <span class="dot" style={`background:var(--p${d.order})`} aria-hidden="true"></span>
            <span class="names">
              <span class="term">{d.term} <span class="ar" lang="ar" dir="rtl">{d.ar}</span></span>
              <span class="en">{d.en} · {d.sections}</span>
            </span>
          </a>
          {/* a moon with scenes links to them after its text; one without stays plain text */}
          <ul>
            {d.moons.map((m, k) => {
              const sc = scenesFor(d.id, k);
              return (
                <li>
                  {m}
                  {sc.map((s, i) => <>{i ? " · " : " "}<a class="scene" href={href(`${d.id}/${s.id}/`)}>{s.title}</a></>)}
                </li>
              );
            })}
          </ul>
        </li>
      ))}
    </ol>
  </div>
  <p class="src">Divisions follow Ibn Ḥajar, <em>Nuzhat al-Naẓar</em> §5.2–5.71 and the summaries at §5.8.2, §5.16.3, §5.38.2 (trans. A. S. Hussain, 2012).</p>
</Page>
<script>
  import "../islands/orbit.ts";
</script>
<style>
  .orbit{fill:none;stroke:var(--rule);stroke-width:1}
  .planet{cursor:pointer;outline:none}
  .planet text{text-anchor:middle}
  .planet .pbody{stroke:none}
  .planet .sat{fill:var(--muted)}
  .planet .ptitle{font:600 12px var(--f-body);font-style:normal;fill:var(--fg);stroke:var(--surface);stroke-width:4px;paint-order:stroke;stroke-linejoin:round}
  .planet .psub{fill:var(--muted);font:600 9.5px var(--f-body);font-style:normal;letter-spacing:.12em;text-transform:uppercase;stroke:var(--surface);stroke-width:4px;paint-order:stroke;stroke-linejoin:round}
  .planet:hover .pbody,.planet:focus-visible .pbody{stroke:var(--fg);stroke-width:2.5}
  .planet:hover .ptitle,.planet:focus-visible .ptitle{fill:var(--fg)}
  .tree{display:none}
  @media (max-width:640px) and (orientation:portrait){
    .stage{display:none}
    .tree{display:block}
  }
  .tree .root{width:56px;margin:0 0 4px}
  .tree .root svg{display:block;width:100%;height:auto}
  .tree ol{list-style:none;margin:0;padding:0 0 0 27px;border-left:2px solid var(--rule);margin-left:27px}
  .tree ol>li{position:relative;padding:10px 0 6px 16px}
  .tree ol>li::before{content:"";position:absolute;left:-27px;top:24px;width:34px;border-top:2px solid var(--rule)}
  .tree .div{display:flex;gap:10px;align-items:flex-start;color:var(--fg);text-decoration:none}
  .tree .div:hover .term,.tree .div:focus-visible .term{text-decoration:underline}
  .tree .dot{flex:none;width:18px;height:18px;border-radius:50%;margin-top:3px}
  .tree .names{display:flex;flex-direction:column;gap:2px}
  .tree .term{font-weight:600}
  .tree .term .ar{font-family:var(--f-ar);font-weight:400;margin-left:6px}
  .tree .en{font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
  .tree ul{margin:6px 0 0 28px;padding-left:16px;color:var(--muted);font-size:.92rem}
  .tree ul li{margin:2px 0}
  .tree ul .scene{color:var(--fg);font-weight:600}
  /* HTML stand-in that carries the planet into the division page (view transitions only capture boxed elements) */
  :global(.vt-planet){position:fixed;border-radius:50%;pointer-events:none;z-index:5}
</style>
