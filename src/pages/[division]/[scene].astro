---
// one scene: one diagram (spec §4.3, §5). The diagram component is picked from the scene's `diagram` field.
import Page from "../../layouts/Page.astro";
import Legend, { type LegendKind } from "../../components/layout/Legend.astro";
import Carousel from "../../components/layout/Carousel.astro";
import ReadAsText from "../../components/layout/ReadAsText.astro";
import ViewSwitch from "../../components/layout/ViewSwitch.astro";
import Routes from "../../components/scenes/Routes.astro";
import Breaks from "../../components/scenes/Breaks.astro";
import Causes from "../../components/scenes/Causes.astro";
import Unknown from "../../components/scenes/Unknown.astro";
import Delivery from "../../components/scenes/Delivery.astro";
import Names from "../../components/scenes/Names.astro";
import Grades from "../../components/scenes/Grades.astro";
import Opposition from "../../components/scenes/Opposition.astro";
import Support from "../../components/scenes/Support.astro";
import ActedOn from "../../components/scenes/ActedOn.astro";
import Report from "../../components/scenes/Report.astro";
import Sorting from "../../components/scenes/Sorting.astro";
import Knowledge from "../../components/scenes/Knowledge.astro";
import Lone from "../../components/scenes/Lone.astro";
import Hidden from "../../components/scenes/Hidden.astro";
import Lying from "../../components/scenes/Lying.astro";
import Slips from "../../components/scenes/Slips.astro";
import Changes from "../../components/scenes/Changes.astro";
import Wording from "../../components/scenes/Wording.astro";
import Identity from "../../components/scenes/Identity.astro";
import Innovation from "../../components/scenes/Innovation.astro";
import { loadContent } from "../../lib/content";
import { captionsFor, type DiagramProps } from "../../lib/scene";
import { href } from "../../lib/url";
import type { CollectionEntry } from "astro:content";

type Diagram = CollectionEntry<"scenes">["data"]["diagram"];

export async function getStaticPaths() {
  const { divisions, scenes } = await loadContent();
  return scenes.map((scene) => {
    const d = divisions.find((x) => x.id === scene.division)!;
    // scenes come sorted by division, then order, so neighbours in the same division are prev/next
    const mine = scenes.filter((s) => s.division === scene.division);
    const i = mine.indexOf(scene);
    return { params: { division: d.id, scene: scene.id }, props: { scene, d, prev: mine[i - 1], next: mine[i + 1] } };
  });
}
const { scene, d, prev, next } = Astro.props;
const { terms } = await loadContent();
const caps = captionsFor(scene, terms);

// each scene task adds its diagram here; import only components that exist
// typed by the props every diagram takes, so a misnamed or missing prop fails astro check
const DIAGRAMS: Partial<Record<Diagram, (p: DiagramProps) => any>> = { Routes, Breaks, Causes, Unknown, Delivery, Names, Grades, Opposition, Support, ActedOn, Report, Sorting, Knowledge, Lone, Hidden, Lying, Slips, Changes, Wording, Identity, Innovation };
const D = DIAGRAMS[scene.diagram];
if (!D) throw new Error(`no diagram component for ${scene.diagram}`);

// figure scenes have both Key and Labels modes (spec §3.5); the legend lists only the kinds each one draws
const LEGEND: Partial<Record<Diagram, LegendKind[]>> = {
  Routes: ["moon", "sahabi", "tabii", "later"],
  Breaks: ["moon", "sahabi", "tabii", "later", "ghost"],
  // cell A's three mini chains, each missing one narrator; cell B's ladder draws no figures
  Causes: ["moon", "sahabi", "tabii", "later", "ghost"],
  Unknown: ["moon", "sahabi", "tabii", "later", "majhul", "mubham"],
  // the mastūr in cell C is the majhūl figure: scroll, empty seal slot
  Grades: ["moon", "sahabi", "tabii", "later", "majhul"],
  // Ḥubayyib ibn Ḥabīb is the weak figure (cracked seal); Ḥammād's dropped link is a skip arrow, not a ghost
  Opposition: ["moon", "sahabi", "tabii", "later", "weak"],
  // the crescent-moon chains: every named narrator is drawn reliable; the dotted elided lines are not figures
  Support: ["moon", "sahabi", "tabii", "later"],
  // the Intentions chain; the "two kinds" view adds a Companion and a plain narrator for "others"
  Report: ["moon", "sahabi", "tabii", "later"],
  // the mutawātir fan is unnamed and illustrative; the clean-routes card draws later narrators
  Knowledge: ["moon", "sahabi", "tabii", "later"],
  // the four lone-narrator chains; the relative column's narrator below the Companion's students is a later one
  Lone: ["moon", "sahabi", "tabii", "later"],
  // the mudallis in panel 1 hides his source; panel 2's narrator is a plain one; the mukhaḍramūn are Successors
  Hidden: ["moon", "tabii", "later", "mudallis", "ghost"],
  // the liar and the suspect side by side; panel 3's forged chain swaps a weak narrator for reliable ones
  Lying: ["later", "liar", "accused", "weak"],
  // the three records: a weak narrator, the gathered routes with a Companion that isn't there, and memory failing
  Slips: ["moon", "sahabi", "tabii", "later", "weak", "mukhtalit", "ghost"],
  // the added narrator and the wavering link are reliable later narrators; the wavering link hangs from a Companion
  Changes: ["moon", "sahabi", "later"],
  // al-Kalbī and the narrator with one student are unknown (scroll, empty seal slot); the students are plain ones and
  // the contrast narrator is drawn reliable
  Identity: ["later", "majhul"],
  // the open sinner is the weak figure (cracked seal); the innovator beside his belief tag is a plain narrator
  Innovation: ["later", "weak"],
  // ActedOn, Sorting and Wording draw no narrator figures, so they have no legend and no Key/Labels switch (phase 3
  // designs §1)
};
const kinds = LEGEND[scene.diagram];
const hasFigures = kinds !== undefined;
const divPath = `${d.id}/`;
---
<Page
  title={`${scene.title} · Nuzhat al-Naẓar, visualised`}
  description={scene.lede}
  crumbs={[{ label: "Map", path: "" }, { label: d.term, path: divPath }, { label: scene.title, path: `${d.id}/${scene.id}/` }]}
  modes={hasFigures}
>
  <div>
    <div class="eyebrow">
      {/* the division page's moon dot for this scene carries the same name, so the moon morphs into the scene
          (spec §5); @view-transition only applies under prefers-reduced-motion: no-preference (motion.css) */}
      <span class="vt-dot" aria-hidden="true" style={`view-transition-name: scene-${scene.id}; background: var(--p${d.order})`}></span>
      {scene.eyebrow}
    </div>
    <h1>{scene.title}</h1>
    <p class="lede">{scene.lede}</p>
  </div>

  {scene.views && (
    <>
      <ViewSwitch views={scene.views} />
      <script>import "../../islands/viewswitch.ts";</script>
    </>
  )}

  <div class="stage-wrap">
    <div class="stage">
      {/* a scene with panels becomes a swipe carousel in portrait (spec §5) */}
      {scene.panels ? (
        <Carousel panels={scene.panels} width={scene.width}><D caps={caps} scene={scene} /></Carousel>
      ) : (
        <D caps={caps} scene={scene} />
      )}
    </div>
    {hasFigures && <Legend kinds={kinds} />}
  </div>
  {scene.panels && <script>import "../../islands/carousel.ts";</script>}

  <p class="src">Ibn Ḥajar, <em>Nuzhat al-Naẓar</em> {scene.source} (trans. A. S. Hussain, 2012).</p>

  <ReadAsText captions={scene.captions.map((c) => caps[c.term])} views={scene.views} extra={scene.extra} />

  <nav class="pn" aria-label="Scenes">
    {prev ? <a rel="prev" href={href(`${d.id}/${prev.id}/`)}>← {prev.title}</a> : <a href={href(divPath)}>← {d.term}</a>}
    {next ? <a rel="next" href={href(`${d.id}/${next.id}/`)}>{next.title} →</a> : <a href={href(divPath)}>{d.term} →</a>}
  </nav>
</Page>
<style>
  .vt-dot{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:8px;vertical-align:-1px}
</style>
