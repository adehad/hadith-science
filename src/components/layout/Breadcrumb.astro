---
import { href } from "../../lib/url";
interface Props { crumbs: { label: string; path: string }[] }
const { crumbs } = Astro.props;
---
<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {crumbs.map((c, i) => (
      <li>
        {i > 0 && <span class="sep" aria-hidden="true">›</span>}
        {i === crumbs.length - 1
          ? <span aria-current="page">{c.label}</span>
          : <a href={href(c.path)}>{c.label}</a>}
      </li>
    ))}
  </ol>
</nav>
<style>
  .crumbs ol{display:flex;flex-wrap:wrap;gap:6px;list-style:none;margin:0;padding:0;font-size:.85rem;opacity:.85}
  .sep{margin-right:6px;opacity:.6}
  .crumbs a{text-decoration:underline;text-underline-offset:2px}
</style>
