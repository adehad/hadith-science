---
// the single term popover for the page (spec §3.5, §6). An HTML overlay rather than the popover
// attribute, which does not work with SVG triggers; src/islands/popover.ts fills, places and shows it.
---
<div id="term-pop" class="term-pop" role="dialog" aria-modal="false" aria-labelledby="term-pop-title" tabindex="-1" hidden>
  <button class="tp-close" type="button" aria-label="Close">×</button>
  <p class="tp-head"><b id="term-pop-title" class="tp-term"></b><span class="tp-ar" lang="ar" dir="rtl"></span></p>
  <p class="tp-def"></p>
  <p class="tp-sec"></p>
  <div class="tp-actions">
    <button type="button" data-act="copy">Copy link</button>
    <button type="button" data-act="share" hidden>Share</button>
    <a data-act="glossary" href="">See in glossary</a>
  </div>
</div>
<style>
  /* the look of the mockup's .tip, made interactive */
  .term-pop{position:fixed;z-index:20;left:16px;top:16px;width:max-content;max-width:min(300px,calc(100vw - 32px));background:var(--fg);color:var(--bg);border-radius:10px;padding:10px 12px;font-size:.9rem;line-height:1.45;box-shadow:0 8px 24px rgba(0,0,0,.25)}
  .term-pop[hidden]{display:none}
  .term-pop:focus{outline:none}
  .term-pop:focus-visible{outline:2px solid var(--gold-b);outline-offset:2px}
  .tp-head{margin:0;padding-right:22px}
  .tp-term{font-family:var(--f-display);font-size:1.05rem}
  .tp-ar{font-family:var(--f-ar);margin-left:6px;opacity:.75}
  .term-pop p{margin:4px 0 0}
  .tp-sec{opacity:.75;font-size:.82rem}
  .tp-close{position:absolute;top:4px;right:6px;border:0;background:transparent;color:inherit;font:700 1.1rem/1 var(--f-body);padding:4px 6px;cursor:pointer;opacity:.75}
  .tp-close:hover{opacity:1}
  .tp-actions{display:flex;flex-wrap:wrap;gap:6px 8px;margin-top:10px;align-items:center}
  .tp-actions button,.tp-actions a{font:600 .8rem var(--f-body);color:inherit;background:transparent;border:1px solid color-mix(in srgb,var(--bg) 45%,transparent);border-radius:999px;padding:4px 10px;cursor:pointer;text-decoration:none}
  .tp-actions button[hidden]{display:none}
  .tp-actions button:hover,.tp-actions a:hover{background:color-mix(in srgb,var(--bg) 14%,transparent)}
  /* phones: a bottom sheet instead of a bubble by the trigger (spec §5) */
  .term-pop.sheet{left:0 !important;right:0;top:auto !important;bottom:0;width:auto;max-width:none;border-radius:14px 14px 0 0;padding:14px max(16px,env(safe-area-inset-right,0px)) max(16px,env(safe-area-inset-bottom,0px)) max(16px,env(safe-area-inset-left,0px));font-size:1rem}
</style>
