<button type="button" class="pill" id="theme-toggle" aria-pressed="false" aria-label="Theme: system. Activate to change.">
  Theme: <span data-theme-label>system</span>
</button>
<style>
  .pill{font:600 .85rem var(--f-body);color:var(--sky-fg);background:transparent;border:1px solid rgba(238,240,251,.3);border-radius:999px;padding:6px 14px;cursor:pointer}
  .pill[aria-pressed="true"]{background:var(--sky-fg);color:var(--sky);border-color:var(--sky-fg)}
</style>
