---
// "Did he hear it from him?" (phase 3 al-Mardūd design §4): the hidden drops of §5.21–5.22, in three panels of one
// 780-wide row, so it carousels in portrait. Each panel pairs lifespan bars with a chain fragment:
//   1  tadlīs: the two lives overlap and the two met (a gold knot); the mudallis cites the shaykh with ʿan or qāla,
//      hiding the one he heard it from
//   2  mursal khafī: the lives overlap, but no meeting is known (a "?"); a plain narrator, since the book doesn't
//      call one who does this a concealer
//   3  the mukhaḍramūn, Ibn Ḥajar's evidence (§5.22): Abū ʿUthmān al-Nahdī and Qays ibn Abī Ḥāzim lived in the
//      Prophet's ﷺ time without a known meeting, and the ḥadīth scholars agree their reports are irsāl, not tadlīs
// The chain fragments look the same in panels 1 and 2, which is the point: the chain alone can't tell them apart.
// The "Other views" switch (§5.22) adds a "counted as tadlīs too" tag over panel 2 and swaps panel 3's verdict for
// Ibn Ḥajar's objection; the groups outside the default view are built with class="off".
// No Arabic report wording (design §18): the delivery words ʿan and qāla are in transliteration only.
// Motion: the skip arrows flow, the ghosts and the "?"s blink, and the knot draws in once. Each resting style is
// the end state, so with motion.css stopping every animation the knot is drawn and nothing blinks.
import Defs from "../svg/Defs.astro";
import Moon from "../svg/Moon.astro";
import Narrator from "../svg/Narrator.astro";
import Arrow from "../svg/Arrow.astro";
import Pill from "../svg/Pill.astro";
import SpeechBubble from "../svg/SpeechBubble.astro";
import Glyph from "../svg/Glyph.astro";
import Bracket from "../svg/Bracket.astro";
import Lifespan from "../svg/Lifespan.astro";
import TermTitle from "../svg/TermTitle.astro";
import { FIG, KIND_NAME, RELIABLE } from "../svg/figures";
import { ROW_TITLE_TRIGGER, SUBT_TRIGGER, panelTrigger } from "../svg/geom";
import { cap, type DiagramProps } from "../../lib/scene";
import { spanOverlap } from "../../lib/kit";
import { loadContent } from "../../lib/content";
import { href } from "../../lib/url";

type Props = DiagramProps;
const { caps, scene } = Astro.props;

const W = 780, H = 520;
const VIEW_IDS = ["ibn-hajar", "contemporary"];
if ((scene.views ?? []).map((v) => v.id).join() !== VIEW_IDS.join()) throw new Error(`Hidden: expected views ${VIEW_IDS.join(", ")}`);
const PANELS = scene.panels ?? [];
if (PANELS.length !== 3) throw new Error("Hidden: expected three panels");

const TITLE_Y = 30, SUB_Y = 50;
// the lifespan rows
const B1 = 74, B2 = 90, B3 = 106;
const UNDER_BARS = 122;
// the chain fragments: the cited shaykh, the hidden ghost, the narrator
const K = 0.75;
const HALF = 22 * K;
const SH_Y = 172, GH_Y = 246, NA_Y = 320;
// the skip arrow's start: below the shaykh's Labels-mode name, which Narrator draws 14 under his feet
const SKIP_Y = SH_Y + HALF + 20;

// a panel title as a term trigger; panelTrigger checks it sits wholly inside its panel
function title(slug: string, cx: number) {
  const c = cap(caps, slug);
  return { c, cx, ...panelTrigger(c.translit, cx, TITLE_Y, PANELS, { ...SUBT_TRIGGER, name: `Hidden: ${slug}` }) };
}
const mudallas = title("mudallas", 130);
const mursalKhafi = title("mursal-khafi", 390);
const mudallis = (() => {
  const c = cap(caps, "mudallis");
  const y = 378;
  return { c, cx: 70, y, ...panelTrigger(c.translit, 70, y, PANELS, { ...ROW_TITLE_TRIGGER, name: "Hidden: mudallis" }) };
})();

// ---- the lifespan bars: overlap only, no dates ----
const P1 = { shaykh: [24, 150] as [number, number], narrator: [70, 190] as [number, number] };
const P2 = { shaykh: [284, 410] as [number, number], narrator: [330, 450] as [number, number] };
const P3 = { prophet: [556, 672] as [number, number], nahdi: [600, 700] as [number, number], qays: [590, 690] as [number, number] };
// each panel's mark sits on the shared stretch of two lives, so they must overlap
function overlap(a: [number, number], b: [number, number], what: string) {
  const o = spanOverlap(a, b);
  if (!o) throw new Error(`Hidden: the ${what} lifespans don't overlap`);
  return o;
}
const knot = overlap(P1.shaykh, P1.narrator, "panel 1");
const q2 = overlap(P2.shaykh, P2.narrator, "panel 2");
const q3 = overlap(P3.prophet, P3.nahdi, "panel 3");

// the two chain fragments, alike on purpose
const FRAGS = [
  { x: 70, fig: FIG.mudallis, label: KIND_NAME.mudallis, says: "ʿan… or qāla…" },
  { x: 330, fig: { ...FIG.later, ...RELIABLE }, label: KIND_NAME.later, says: "ʿan…" },
];

// panel 3: the moon and the two mukhaḍramūn, Successors from general knowledge (design §1, §18)
const MOON = { x: 650, y: 172, k: 0.6 };
const MK = 0.7, MHALF = 22 * MK;
const MUKH = [
  { x: 596, lines: ["Abū ʿUthmān", "al-Nahdī"], bend: -16 },
  { x: 704, lines: ["Qays ibn", "Abī Ḥāzim"], bend: 16 },
];

// the al-mazīd cell of "What changed in the telling?" gets a link once that scene exists, so no build ships a
// broken one (design §18). It lands on the al-mazīd term, opening its note, when the scene carries it.
const { scenes } = await loadContent();
const changes = scenes.find((s) => s.division === "al-mardud" && s.id === "changes");
const mazidLink = changes && `al-mardud/${changes.id}/${changes.captions.some((c) => c.term === "mazid") ? "#mazid" : ""}`;
---
<svg viewBox={`0 0 ${W} ${H}`} class="hidden-scene" role="group" aria-label="Three panels, each with two lifespans over a chain fragment. Mudallas: the narrator and his shaykh lived at the same time and met; the narrator, a concealer, cites the shaykh with ʿan or qāla, hiding the one he heard it from. With words of certainty he would be a liar; his report is not accepted until he says he heard. Mursal khafī: the two lived at the same time, but no meeting is known; the chain looks the same. That they never met is shown by his own word or a versed imam's firm statement; an extra narrator in some versions is no proof. Lived in his time: Abū ʿUthmān al-Nahdī and Qays ibn Abī Ḥāzim lived in the Prophet's ﷺ time without a known meeting, and the ḥadīth scholars agree their reports are irsāl, not tadlīs, so a meeting, not a shared lifetime, is what tadlīs needs.">
  <Defs />
  <line class="divider" x1="260" x2="260" y1="12" y2={H - 12} />
  <line class="divider" x1="520" x2="520" y1="12" y2={H - 12} />

  {/* ---- titles ---- */}
  <TermTitle c={mudallas.c} x={mudallas.cx} y={TITLE_Y} cls="subt" hit={mudallas.hit} info={mudallas.info} />
  <text class="lbl" x="130" y={SUB_Y}>a hidden drop</text>
  <TermTitle c={mursalKhafi.c} x={mursalKhafi.cx} y={TITLE_Y} cls="subt" hit={mursalKhafi.hit} info={mursalKhafi.info} />
  <text class="lbl" x="390" y={SUB_Y}>never known to have met</text>
  <text class="subt" x="650" y={TITLE_Y}>Lived in his time</text>
  <text class="lbl" x="650" y={SUB_Y}>Ibn Ḥajar's evidence</text>

  {/* ---- panel 1: they met ---- */}
  <Lifespan x0={P1.shaykh[0]} x1={P1.shaykh[1]} y={B1} name="shaykh" />
  <Lifespan x0={P1.narrator[0]} x1={P1.narrator[1]} y={B2} name="narrator" />
  <g class="knot-g" aria-hidden="true">
    <path class="knot" pathLength="1" d={`M${knot.mid} ${B1} V${B2}`} />
    <circle class="knot-dot" cx={knot.mid} cy={B1} r="3.4" />
    <circle class="knot-dot" cx={knot.mid} cy={B2} r="3.4" />
  </g>
  <text class="lbl sm" x={knot.mid} y={UNDER_BARS - 8}>met</text>

  {/* ---- panel 2: never known to meet ---- */}
  <Lifespan x0={P2.shaykh[0]} x1={P2.shaykh[1]} y={B1} name="shaykh" />
  <Lifespan x0={P2.narrator[0]} x1={P2.narrator[1]} y={B2} name="narrator" />
  <text class="q" x={q2.mid} y={(B1 + B2) / 2 + 5} aria-hidden="true">?</text>
  <text class="lbl sm" x={q2.mid} y={UNDER_BARS - 8}>same time, no known meeting</text>

  {/* ---- panels 1 and 2: the chain fragments ---- */}
  {FRAGS.map((p) => (
    <>
      {/* the narrator's citation jumps the one he heard it from, as Chain draws a dropped link. It starts below the
          shaykh's Labels-mode name and bends wide enough to clear the ghost's */}
      <Arrow x1={p.x - 4} y1={SKIP_Y} x2={p.x - 4} y2={NA_Y - HALF - 4} bend={-80} variant="skip" />
      <Narrator x={p.x} y={SH_Y} k={K} {...FIG.later} {...RELIABLE} label={KIND_NAME.later} />
      <text class="nm" x={p.x + 22} y={SH_Y + 4}>the shaykh</text>
      <Narrator x={p.x} y={GH_Y} k={K} {...FIG.ghost} label={KIND_NAME.ghost} />
      <text class="lbl gap start" x={p.x + 22} y={GH_Y - 6}>hidden:</text>
      <text class="lbl gap start sm" x={p.x + 22} y={GH_Y + 8}>the one he heard it from</text>
      <Narrator x={p.x} y={NA_Y} k={K} {...p.fig} label={p.label} />
      <SpeechBubble x={p.x} y={NA_Y} en={p.says} />
    </>
  ))}

  {/* ---- panel 1, below: the concealer ---- */}
  <TermTitle c={mudallis.c} x={mudallis.cx} y={mudallis.y} cls="rt mid" hit={mudallis.hit} info={mudallis.info} />
  <text class="lbl gap" x="130" y="408">with words of certainty instead,</text>
  <text class="lbl gap" x="130" y="423">he would be a liar</text>
  <Pill x={130} y={454} state="pause" text="Not accepted until he says he heard" />
  <text class="lbl sm" x="130" y="480">on the most correct opinion</text>

  {/* ---- panel 2, below: how a missing meeting is known ---- */}
  <Glyph kind="text" cx={290} cy={396} r={8} />
  <text class="lbl start sm" x="304" y="394">never met: shown by his own word</text>
  <text class="lbl start sm" x="304" y="409">or a versed imam's firm statement</text>
  <text class="lbl sm" x="390" y="446">an extra narrator in some versions</text>
  <text class="lbl sm" x="390" y="461">is no proof: it may be an addition</text>
  {mazidLink && (
    <a class="xlink" href={href(mazidLink)} aria-label={`An extra narrator: see al-mazīd in ${changes.title}`}>
      <text class="rp" x="390" y="484" text-anchor="middle"><tspan class="xu">{changes.title}</tspan><tspan dx="5">→</tspan></text>
    </a>
  )}

  {/* ---- panel 3: the mukhaḍramūn ---- */}
  <Moon cx={P3.prophet[0] - 12} cy={B1} k={0.28} />
  <Lifespan x0={P3.prophet[0]} x1={P3.prophet[1]} y={B1} name="the Prophet ﷺ" tone="moon" />
  <Lifespan x0={P3.nahdi[0]} x1={P3.nahdi[1]} y={B2} name="Abū ʿUthmān" />
  <Lifespan x0={P3.qays[0]} x1={P3.qays[1]} y={B3} name="Qays" />
  <text class="q" x={q3.mid} y={(B1 + B2) / 2 + 5} aria-hidden="true">?</text>
  <text class="lbl sm" x="650" y={UNDER_BARS + 6}>lived in his time · met him?</text>

  <Moon cx={MOON.x} cy={MOON.y} k={MOON.k} />
  {MUKH.map((m) => (
    <>
      <Arrow x1={MOON.x + Math.sign(m.bend) * 8} y1={MOON.y + 24 * MOON.k + 3} x2={m.x} y2={NA_Y - MHALF - 4} bend={m.bend} variant="skip" />
      <Narrator x={m.x} y={NA_Y} k={MK} {...FIG.tabii} {...RELIABLE} label={KIND_NAME.tabii} />
      {m.lines.map((t, j) => <text class="sn" x={m.x} y={366 + j * 13}>{t}</text>)}
    </>
  ))}
  <g data-view-show="ibn-hajar">
    <Pill x={650} y={414} state="accept" text="irsāl, not tadlīs" />
    <text class="lbl sm" x="650" y="438">the ḥadīth scholars agree</text>
    <text class="lbl" x="650" y="466">so a meeting, not a shared</text>
    <text class="lbl" x="650" y="481">lifetime, is what tadlīs needs</text>
  </g>
  <g class="off" data-view-show="contemporary">
    <g class="dashed"><Pill x={644} y={414} state="pause" text="then mudallis" /></g>
    <text class="q" x="715" y="420" aria-hidden="true">?</text>
    <text class="lbl sm" x="650" y="438">yet the scholars call it irsāl</text>
    <text class="lbl" x="650" y="466">so living at the same time</text>
    <text class="lbl" x="650" y="481">can't be enough for tadlīs</text>
  </g>

  {/* ---- the other view: the hidden mursal counted as tadlīs ---- */}
  <g class="off" data-view-show="contemporary">
    <g class="dashed" aria-hidden="true"><Bracket x0={knot.mid} x1={318} y={136} ticks="up" /></g>
    <rect class="vtag" x="320" y="125" width="140" height="22" rx="11" />
    <text class="vtag-t" x="390" y="140">counted as tadlīs too</text>
  </g>
</svg>
<style>
  .q{fill:var(--gap);font:700 15px var(--f-body);text-anchor:middle;stroke:var(--surface);stroke-width:3px;paint-order:stroke;animation:blink 2.4s ease-in-out infinite}
  /* TermTitle draws the text, so the centring has to reach into it */
  .hidden-scene :global(.rt.mid){text-anchor:middle}
  .knot{fill:none;stroke:var(--gold-a);stroke-width:2.4;stroke-linecap:round;stroke-dasharray:1;stroke-dashoffset:0;animation:hidden-knot .6s ease-out .4s both}
  .knot-dot{fill:var(--gold-b);stroke:var(--gold-a);stroke-width:1}
  /* the resting style is drawn; the animation runs from undrawn, once */
  @keyframes hidden-knot{from{stroke-dashoffset:1}to{stroke-dashoffset:0}}
  .dashed :global(rect),.dashed :global(path){stroke-dasharray:4 3}
  .vtag{fill:color-mix(in srgb,var(--pause) 12%,var(--surface));stroke:var(--pause);stroke-width:1.4;stroke-dasharray:4 3}
  .vtag-t{fill:color-mix(in srgb,var(--pause) 65%,var(--fg));font:700 11.5px var(--f-body);text-anchor:middle}
</style>
