---
// a speech bubble to the right of the figure at (x, y): what that narrator says about his source
// (ported from the mockup's speech(); quoted delivery words come from the speaker, spec §3.3)
interface Props { x: number; y: number; ar: string; en: string }
const { x, y, ar, en } = Astro.props;
const bx = x + 30;
const by = y - 46;
---
<g class="bubble">
  <path d={`M${bx + 10} ${by} h124 q8 0 8 8 v30 q0 8 -8 8 h-112 l-14 14 l2 -14 q-8 0 -8 -8 v-30 q0 -8 8 -8z`} />
  <text class="lbl ar" x={bx + 72} y={by + 20} lang="ar" direction="rtl">{ar}</text>
  <text class="lbl" x={bx + 72} y={by + 38}>{en}</text>
</g>
<style>
  .bubble path{fill:var(--surface);stroke:var(--line);stroke-width:1.5}
</style>
