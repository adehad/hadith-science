---
// shared SVG defs (from the mockup's hidden <svg> block): the Companion's shimmering gold, used by
// Narrator kind="sahabi", and the arrowheads used by Arrow. IDs are page-global, so a page includes this
// once, inside its first diagram SVG; later SVGs on the same page reference the same IDs.
---
<defs>
  <linearGradient id="gold" x1="0" y1="0" x2="1" y2="1">
    <stop offset="0" style="stop-color:var(--gold-a)" />
    <stop offset=".38" style="stop-color:var(--gold-b)" />
    <stop offset=".5" style="stop-color:var(--gold-c)" />
    <stop offset=".62" style="stop-color:var(--gold-b)" />
    <stop offset="1" style="stop-color:var(--gold-a)" />
    <animateTransform class="shimmer" attributeName="gradientTransform" type="translate" values="-1 -1;1 1;1 1" keyTimes="0;.6;1" dur="3.2s" repeatCount="indefinite" />
  </linearGradient>
  <marker id="ah" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="arrowhead" d="M0 0 L10 5 L0 10 z" /></marker>
  <marker id="ahg" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="arrowhead gap" d="M0 0 L10 5 L0 10 z" /></marker>
  {/* held back's arrow to the rejected (Sorting), in the pause colour */}
  <marker id="ahp" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="arrowhead pause" d="M0 0 L10 5 L0 10 z" /></marker>
  {/* the lift arrow's head; markerUnits scale with its 5-wide stroke, so it is drawn small */}
  <marker id="ahl" viewBox="0 0 10 10" refX="2" refY="5" markerWidth="3.6" markerHeight="3.6" orient="auto-start-reverse"><path class="arrowhead gold" d="M0 0 L10 5 L0 10 z" /></marker>
  {/* the implied arrow's head (Raised), in gold at the flow arrow's size */}
  <marker id="ahi" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="arrowhead gold" d="M0 0 L10 5 L0 10 z" /></marker>
</defs>
