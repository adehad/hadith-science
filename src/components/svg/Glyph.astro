---
// small drawn icons centred on (cx, cy) in a 2r box (phase 3 design §7): no text glyphs, for the same reason
// as InfoIcon (WCAG 2.5.3). memory: a head with a mark inside it; book: an open book; check: a tick in a box; lens: a magnifying glass, for searching;
// pause: two bars in a ring; text: a page of lines; companion: a bust with a star, in the Companions' gold; clock: a
// face with two hands, for dates.
// The tick is a .tick path, so a scene can draw it in with a stroke-dash animation.
import { f } from "./geom";

interface Props { kind: "memory" | "book" | "check" | "lens" | "pause" | "text" | "companion" | "clock"; cx: number; cy: number; r?: number }
const { kind, cx, cy, r = 7 } = Astro.props;
const p = (dx: number, dy: number) => `${f(cx + dx * r)} ${f(cy + dy * r)}`;
---
<g class={`glyph-${kind}`} aria-hidden="true">
  {kind === "check" && (
    <>
      <rect class="gbox" x={f(cx - r)} y={f(cy - r)} width={f(2 * r)} height={f(2 * r)} rx={f(r * 0.3)} />
      <path class="tick" pathLength="1" d={`M${p(-0.55, 0)} L${p(-0.12, 0.45)} L${p(0.6, -0.5)}`} />
    </>
  )}
  {kind === "memory" && (
    <>
      <path class="gline" d={`M${p(-0.5, 1)} L${p(-0.5, 0.45)} Q${p(-0.95, 0.1)} ${p(-0.85, -0.3)} Q${p(-0.7, -1)} ${p(0.05, -1)} Q${p(0.8, -1)} ${p(0.85, -0.2)} L${p(1, 0.25)} L${p(0.75, 0.3)} L${p(0.7, 1)}`} />
      <circle class="gdot" cx={f(cx + 0.02 * r)} cy={f(cy - 0.3 * r)} r={f(r * 0.24)} />
    </>
  )}
  {kind === "book" && (
    <path class="gline" d={`M${p(0, -0.55)} Q${p(-0.5, -0.85)} ${p(-1, -0.55)} L${p(-1, 0.75)} Q${p(-0.5, 0.45)} ${p(0, 0.75)} Q${p(0.5, 0.45)} ${p(1, 0.75)} L${p(1, -0.55)} Q${p(0.5, -0.85)} ${p(0, -0.55)} Z M${p(0, -0.55)} L${p(0, 0.75)}`} />
  )}
  {kind === "lens" && (
    <>
      <circle class="glens" cx={f(cx - 0.2 * r)} cy={f(cy - 0.2 * r)} r={f(0.62 * r)} />
      <path class="ghandle" d={`M${p(0.25, 0.25)} L${p(0.95, 0.95)}`} />
    </>
  )}
  {kind === "pause" && (
    <>
      <circle class="gring pause" cx={cx} cy={cy} r={f(r * 0.95)} />
      <path class="gbars" d={`M${p(-0.28, -0.42)} L${p(-0.28, 0.42)} M${p(0.28, -0.42)} L${p(0.28, 0.42)}`} />
    </>
  )}
  {kind === "text" && (
    <path class="gline" d={`M${p(-0.7, -1)} L${p(0.35, -1)} L${p(0.7, -0.65)} L${p(0.7, 1)} L${p(-0.7, 1)} Z M${p(-0.4, -0.45)} L${p(0.4, -0.45)} M${p(-0.4, 0)} L${p(0.4, 0)} M${p(-0.4, 0.45)} L${p(0.15, 0.45)}`} />
  )}
  {kind === "companion" && (
    <>
      <circle class="gold-line" cx={f(cx - 0.15 * r)} cy={f(cy - 0.35 * r)} r={f(r * 0.38)} />
      <path class="gold-line" d={`M${p(-0.85, 1)} Q${p(-0.85, 0.15)} ${p(-0.15, 0.15)} Q${p(0.55, 0.15)} ${p(0.55, 1)}`} />
      <path class="gstar" d={`M${p(0.72, -1)} L${p(0.82, -0.72)} L${p(1.1, -0.72)} L${p(0.88, -0.55)} L${p(0.96, -0.27)} L${p(0.72, -0.44)} L${p(0.48, -0.27)} L${p(0.56, -0.55)} L${p(0.34, -0.72)} L${p(0.62, -0.72)} Z`} />
    </>
  )}
  {kind === "clock" && (
    <>
      <circle class="gring" cx={cx} cy={cy} r={f(r * 0.95)} />
      <path class="gline" d={`M${p(0, -0.6)} L${p(0, 0)} L${p(0.45, 0.25)}`} />
    </>
  )}
</g>
<style>
  .gbox{fill:var(--surface);stroke:var(--line);stroke-width:1.3}
  .tick{fill:none;stroke:var(--green);stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
  .gline{fill:none;stroke:var(--fg);stroke-width:1.4;stroke-linejoin:round;stroke-linecap:round}
  .gdot{fill:var(--fg)}
  .glens{fill:var(--surface);fill-opacity:.6;stroke:var(--fg);stroke-width:1.6}
  .ghandle{fill:none;stroke:var(--fg);stroke-width:2.6;stroke-linecap:round}
  .gring{fill:var(--surface);stroke:var(--fg);stroke-width:1.4}
  .gring.pause{stroke:var(--pause);stroke-width:1.6}
  .gbars{fill:none;stroke:var(--pause);stroke-width:2.2;stroke-linecap:round}
  .gold-line{fill:none;stroke:var(--gold-a);stroke-width:1.6;stroke-linecap:round}
  .gstar{fill:var(--gold-a)}
</style>
