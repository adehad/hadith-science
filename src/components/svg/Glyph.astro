---
// small drawn icons centred on (cx, cy) in a 2r box (phase 3 design §7): no text glyphs, for the same reason
// as InfoIcon (WCAG 2.5.3). memory: a head with a mark inside it; book: an open book; check: a tick in a box; lens: a magnifying glass, for searching;
// pause: two bars in a ring; text: a page of lines; companion: a bust with a star, in the Companions' gold; clock: a
// face with two hands, for dates; cross: a drawn ✕ in a box, for rejected or not reached, the same stroke as check.
// coin: a disc with an inner ring, for the money-changer (phase 3 al-Mardūd design §6); dashed draws a false one.
// scissors: a pair pointing down, closed, for cutting a text short (al-Mardūd design §8). Each half (handle ring and
// blade) is a .sblade group pivoting on the screw, so a scene can open and close them with a rotation.
// handshake: two forearms meeting in a clasp, for muṣāfaḥa (phase 3 lataif design §11).
// The tick is a .tick path and the cross an .xmark path, each with pathLength 1. With animate, the tick and cross
// draw in (motion.css .m-draw) and each scissor half comes in (.m-enter, from the --from-r the scene sets on it),
// timed by the --d and --dur the scene sets on a wrapping group.
import { f } from "./geom";

interface Props { kind: "memory" | "book" | "check" | "cross" | "lens" | "pause" | "text" | "companion" | "clock" | "coin" | "scissors" | "handshake"; cx: number; cy: number; r?: number; dashed?: boolean; animate?: boolean }
const { kind, cx, cy, r = 7, dashed = false, animate = false } = Astro.props;
const p = (dx: number, dy: number) => `${f(cx + dx * r)} ${f(cy + dy * r)}`;
---
<g class={`glyph-${kind}`} aria-hidden="true">
  {kind === "check" && (
    <>
      <rect class="gbox" x={f(cx - r)} y={f(cy - r)} width={f(2 * r)} height={f(2 * r)} rx={f(r * 0.3)} />
      <path class:list={["tick", { "m-draw": animate }]} pathLength="1" d={`M${p(-0.55, 0)} L${p(-0.12, 0.45)} L${p(0.6, -0.5)}`} />
    </>
  )}
  {kind === "cross" && (
    <>
      <rect class="gbox" x={f(cx - r)} y={f(cy - r)} width={f(2 * r)} height={f(2 * r)} rx={f(r * 0.3)} />
      <path class:list={["xmark", { "m-draw": animate }]} pathLength="1" d={`M${p(-0.45, -0.45)} L${p(0.45, 0.45)} M${p(0.45, -0.45)} L${p(-0.45, 0.45)}`} />
    </>
  )}
  {kind === "memory" && (
    <>
      <path class="gline" d={`M${p(-0.5, 1)} L${p(-0.5, 0.45)} Q${p(-0.95, 0.1)} ${p(-0.85, -0.3)} Q${p(-0.7, -1)} ${p(0.05, -1)} Q${p(0.8, -1)} ${p(0.85, -0.2)} L${p(1, 0.25)} L${p(0.75, 0.3)} L${p(0.7, 1)}`} />
      <circle class="gdot" cx={f(cx + 0.02 * r)} cy={f(cy - 0.3 * r)} r={f(r * 0.24)} />
    </>
  )}
  {kind === "book" && (
    <path class="gline" d={`M${p(0, -0.55)} Q${p(-0.5, -0.85)} ${p(-1, -0.55)} L${p(-1, 0.75)} Q${p(-0.5, 0.45)} ${p(0, 0.75)} Q${p(0.5, 0.45)} ${p(1, 0.75)} L${p(1, -0.55)} Q${p(0.5, -0.85)} ${p(0, -0.55)} Z M${p(0, -0.55)} L${p(0, 0.75)}`} />
  )}
  {kind === "lens" && (
    <>
      <circle class="glens" cx={f(cx - 0.2 * r)} cy={f(cy - 0.2 * r)} r={f(0.62 * r)} />
      <path class="ghandle" d={`M${p(0.25, 0.25)} L${p(0.95, 0.95)}`} />
    </>
  )}
  {kind === "pause" && (
    <>
      <circle class="gring pause" cx={cx} cy={cy} r={f(r * 0.95)} />
      <path class="gbars" d={`M${p(-0.28, -0.42)} L${p(-0.28, 0.42)} M${p(0.28, -0.42)} L${p(0.28, 0.42)}`} />
    </>
  )}
  {kind === "text" && (
    <path class="gline" d={`M${p(-0.7, -1)} L${p(0.35, -1)} L${p(0.7, -0.65)} L${p(0.7, 1)} L${p(-0.7, 1)} Z M${p(-0.4, -0.45)} L${p(0.4, -0.45)} M${p(-0.4, 0)} L${p(0.4, 0)} M${p(-0.4, 0.45)} L${p(0.15, 0.45)}`} />
  )}
  {kind === "companion" && (
    <>
      <circle class="gold-line" cx={f(cx - 0.15 * r)} cy={f(cy - 0.35 * r)} r={f(r * 0.38)} />
      <path class="gold-line" d={`M${p(-0.85, 1)} Q${p(-0.85, 0.15)} ${p(-0.15, 0.15)} Q${p(0.55, 0.15)} ${p(0.55, 1)}`} />
      <path class="gstar" d={`M${p(0.72, -1)} L${p(0.82, -0.72)} L${p(1.1, -0.72)} L${p(0.88, -0.55)} L${p(0.96, -0.27)} L${p(0.72, -0.44)} L${p(0.48, -0.27)} L${p(0.56, -0.55)} L${p(0.34, -0.72)} L${p(0.62, -0.72)} Z`} />
    </>
  )}
  {kind === "clock" && (
    <>
      <circle class="gring" cx={cx} cy={cy} r={f(r * 0.95)} />
      <path class="gline" d={`M${p(0, -0.6)} L${p(0, 0)} L${p(0.45, 0.25)}`} />
    </>
  )}
  {kind === "handshake" && (
    <>
      {/* two forearms, each with a cuff, rising to the clasp */}
      <path class="gline" d={`M${p(-1.1, 0.35)} L${p(-0.5, -0.05)} M${p(-1.1, 0.85)} L${p(-0.5, 0.45)} M${p(-0.82, 0.16)} L${p(-0.82, 0.66)} M${p(1.1, 0.35)} L${p(0.5, -0.05)} M${p(1.1, 0.85)} L${p(0.5, 0.45)} M${p(0.82, 0.16)} L${p(0.82, 0.66)}`} />
      {/* the joined band of the two hands, with a thumb over it and the fingers' lines */}
      <rect class="gline" x={f(cx - 0.5 * r)} y={f(cy - 0.12 * r)} width={f(r)} height={f(0.62 * r)} rx={f(0.22 * r)} />
      <path class="gline" d={`M${p(-0.32, -0.12)} Q${p(-0.05, -0.42)} ${p(0.22, -0.12)} M${p(-0.15, -0.12)} L${p(-0.15, 0.5)} M${p(0.12, -0.12)} L${p(0.12, 0.5)}`} />
    </>
  )}
  {kind === "scissors" && (
    <>
      {([["a", -1], ["b", 1]] as const).map(([side, s]) => (
        <g class:list={["sblade", side, { "m-enter": animate }]} style={`transform-box:view-box;transform-origin:${cx}px ${f(cy + 0.1 * r)}px`}>
          <circle class="gring-s" cx={f(cx + s * 0.45 * r)} cy={f(cy - 0.62 * r)} r={f(0.3 * r)} />
          <path class="gblade" d={`M${p(s * 0.3, -0.36)} L${p(0, 0.1)} L${p(-s * 0.12, 1)}`} />
        </g>
      ))}
      <circle class="gscrew" cx={cx} cy={f(cy + 0.1 * r)} r={f(Math.max(1, 0.08 * r))} />
    </>
  )}
  {kind === "coin" && (
    <>
      <circle class:list={["gcoin", { dashed }]} cx={cx} cy={cy} r={f(r * 0.95)} />
      <circle class:list={["gcoin-in", { dashed }]} cx={cx} cy={cy} r={f(r * 0.6)} />
    </>
  )}
</g>
<style>
  .gbox{fill:var(--surface);stroke:var(--line);stroke-width:1.3}
  .tick{fill:none;stroke:var(--green);stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
  .xmark{fill:none;stroke:var(--gap);stroke-width:2.2;stroke-linecap:round}
  .gline{fill:none;stroke:var(--fg);stroke-width:1.4;stroke-linejoin:round;stroke-linecap:round}
  .gdot{fill:var(--fg)}
  .glens{fill:var(--surface);fill-opacity:.6;stroke:var(--fg);stroke-width:1.6}
  .ghandle{fill:none;stroke:var(--fg);stroke-width:2.6;stroke-linecap:round}
  .gring{fill:var(--surface);stroke:var(--fg);stroke-width:1.4}
  .gring.pause{stroke:var(--pause);stroke-width:1.6}
  .gbars{fill:none;stroke:var(--pause);stroke-width:2.2;stroke-linecap:round}
  .gold-line{fill:none;stroke:var(--gold-a);stroke-width:1.6;stroke-linecap:round}
  .gstar{fill:var(--gold-a)}
  .gring-s{fill:none;stroke:var(--fg);stroke-width:1.5}
  .gblade{fill:none;stroke:var(--fg);stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  .gscrew{fill:var(--fg)}
  .gcoin{fill:var(--gold-b);stroke:var(--gold-a);stroke-width:1.4}
  .gcoin-in{fill:none;stroke:var(--gold-a);stroke-width:1}
  .gcoin.dashed{fill:var(--surface);stroke:var(--gap);stroke-dasharray:3 2}
  .gcoin-in.dashed{stroke:var(--gap);stroke-dasharray:2 2}
</style>
