---
// a verdict pill centred on (x, y) (ported from the mockup's pill()); its width follows the text length.
// gold marks one of two reports acted on (phase 3 design §5.2). Each state's text is its ink on its own tint
// (tokens.css), a pair that reaches 4.5:1 in both themes (tests/unit/contrast.test.ts)
import { f } from "./geom";
import { pillWidth } from "../../lib/kit";

interface Props { x: number; y: number; text: string; state: "pause" | "accept" | "support" | "reject" | "gold" }
const { x, y, text, state } = Astro.props;
const w = pillWidth(text);
---
<g class={`pill ${state}`}>
  <rect x={f(x - w / 2)} y={y - 12} width={w} height="24" rx="12" />
  <text x={x} y={y + 4}>{text}</text>
</g>
<style>
  .pill rect{stroke-width:1.5}
  .pill text{font:700 11.5px var(--f-body);text-anchor:middle;letter-spacing:.02em}
  .pill.pause rect{fill:var(--pause-tint);stroke:var(--pause)} .pill.pause text{fill:var(--pause-ink)}
  .pill.accept rect{fill:var(--ok-tint);stroke:var(--ok)}
  .pill.support rect{fill:var(--support-tint);stroke:var(--ok);stroke-dasharray:4 3}
  .pill.accept text, .pill.support text{fill:var(--ok-ink)}
  .pill.reject rect{fill:var(--gap-tint);stroke:var(--gap)} .pill.reject text{fill:var(--gap-ink)}
  .pill.gold rect{fill:var(--gold-tint);stroke:var(--gold-a)} .pill.gold text{fill:var(--gold-ink)}
</style>
