---
// a verdict pill centred on (x, y) (ported from the mockup's pill()); its width follows the text length
import { f } from "./geom";

interface Props { x: number; y: number; text: string; state: "pause" | "accept" | "support" | "reject" }
const { x, y, text, state } = Astro.props;
const w = f(text.length * 6.6 + 24);
---
<g class={`pill ${state}`}>
  <rect x={f(x - w / 2)} y={y - 12} width={w} height="24" rx="12" />
  <text x={x} y={y + 4}>{text}</text>
</g>
<style>
  .pill rect{stroke-width:1.5}
  .pill text{font:700 11.5px var(--f-body);text-anchor:middle;letter-spacing:.02em}
  .pill.pause rect{fill:color-mix(in srgb,var(--pause) 16%,var(--surface));stroke:var(--pause)} .pill.pause text{fill:var(--pause)}
  .pill.accept rect{fill:color-mix(in srgb,var(--ok) 16%,var(--surface));stroke:var(--ok)} .pill.accept text{fill:var(--ok)}
  .pill.support rect{fill:color-mix(in srgb,var(--ok) 10%,var(--surface));stroke:var(--ok);stroke-dasharray:4 3} .pill.support text{fill:var(--ok)}
  .pill.reject rect{fill:color-mix(in srgb,var(--gap) 12%,var(--surface));stroke:var(--gap)} .pill.reject text{fill:var(--gap)}
</style>
