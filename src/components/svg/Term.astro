---
// an SVG term trigger: popover.ts makes any [data-term][data-term-json] a button (role, tabindex, keys).
// x, y, w, h give the hit rectangle in SVG units; the caller puts the visible text and an <InfoIcon> in the slot.
// On a carousel scene ([scene].astro sets Astro.locals.panels) the build fails if the hit rectangle leaves its panel.
// A trigger inside any translated group must pass dx, the group's x offset in each place it is drawn (one per view;
// [0] for a purely vertical shift), since x alone is not where it lands; each place is checked.
import { assertInPanel } from "../../lib/panels";

interface Props { slug: string; json: string; label: string; x: number; y: number; w: number; h: number; dx?: number[] }
const { slug, json, label, x, y, w, h, dx = [0] } = Astro.props;
const panels = Astro.locals.panels;
if (panels) for (const d of dx) assertInPanel({ x: x + d, w }, panels, slug);
---
<g class="term" data-term={slug} data-term-json={json} aria-label={label}>
  <rect class="hit" x={x} y={y} width={w} height={h} rx="8" />
  <slot />
</g>
<style>
  .term{cursor:pointer;outline:none}
  .term .hit{fill:transparent;stroke:none}
  .term:focus-visible .hit{stroke:var(--gold-b);stroke-width:2}
</style>
