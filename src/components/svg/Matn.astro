---
// a text card for a quoted report (phase 3 design §7): a scroll-edged card at (x, y), w by h, holding an
// optional Arabic line (lang="ar") over English lines, centred. `added` is a tail appended to the last line as
// a <tspan class="added"> that pulses: the words one narrator adds that others leave out. `inactive` marks a report
// not acted on (rejected, abrogated or paused) with a dashed edge and a muted fill, keeping the text opaque: the
// ink keeps 4.5:1 or better on the muted fill, which is the same in both themes, as --moon is.
interface Props { x: number; y: number; w: number; h: number; lines?: string[]; ar?: string; added?: string; inactive?: boolean }
const { x, y, w, h, lines = [], ar, added, inactive = false } = Astro.props;
const LH = 15;
const cx = x + w / 2;
const rows = added && lines.length === 0 ? [""] : lines;
// the text block sits in the middle of the card
const n = rows.length + (ar ? 1 : 0);
const top = y + h / 2 - ((n - 1) * LH) / 2 + 4;
---
<g class:list={["matn", { inactive }]}>
  <rect class="card" x={x} y={y} width={w} height={h} rx="2" />
  <rect class="roll" x={x - 3} y={y - 3} width="6" height={h + 6} rx="3" />
  <rect class="roll" x={x + w - 3} y={y - 3} width="6" height={h + 6} rx="3" />
  {ar && <text class="mar" lang="ar" direction="rtl" x={cx} y={top}>{ar}</text>}
  {rows.map((t, i) => (
    <text class="men" x={cx} y={top + (i + (ar ? 1 : 0)) * LH}>{t}{added && i === rows.length - 1 && <tspan class="added">{added}</tspan>}</text>
  ))}
</g>
<style>
  .card{fill:var(--moon);stroke:var(--moon-ink);stroke-width:.9}
  .roll{fill:var(--moon);stroke:var(--moon-ink);stroke-width:.9}
  .men{fill:var(--moon-ink);font:600 11px var(--f-body);text-anchor:middle}
  .mar{fill:var(--moon-ink);font:400 14px var(--f-ar);text-anchor:middle}
  .inactive .card,.inactive .roll{fill:color-mix(in srgb,var(--moon) 84%,var(--line))}
  .inactive .card{stroke-dasharray:4 3}
  .added{fill:var(--ok);font-weight:700;animation:blink 2.4s ease-in-out infinite}
</style>
