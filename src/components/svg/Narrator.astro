---
// a narrator figure in the 40x44 person space, drawn at scale k (1.5 by default) and centred on (x, y)
// (ported from the mockup's fig(), BODY and ACC). The scroll means his identity is known, the seal that
// someone vouches for him; a missing item is an empty slot that blinks (spec §3.2).
// Sahabi figures fill with url(#gold): the page holding them must include <Defs /> once.
import { f } from "./geom";

interface Props {
  x: number;
  y: number;
  kind?: "sahabi" | "tabii" | "later";
  face?: "blank" | "faded" | "mask" | "mask-dashed" | "hand";
  scroll?: "yes" | "slot";
  seal?: "yes" | "slot" | "crack" | "void";
  /** an outline instead of a figure: ghost, the dashed red narrator dropped from a chain (spec §3.2); unborn, a
   *  dashed grey outline for someone not yet born (Ṣiyagh al-adāʾ design §7). No scroll, seal or face either way. */
  variant?: "ghost" | "unborn";
  /** figure scale; 1.5 in the figure key, 0.9 in chains */
  k?: number;
  /** kind name drawn under the figure, shown only in Labels mode (spec §3.5) */
  label?: string;
}
const { x, y, kind = "later", face, scroll, seal, variant, k = 1.5, label } = Astro.props;
const BODY = "M3 43 Q3 23 20 23 Q37 23 37 43 Z";
const transform = `translate(${f(x - 20 * k)} ${f(y - 22 * k)}) scale(${k})`;
---
{variant ? (
  <g transform={transform}>
    <circle class={`n ${variant}`} cx="20" cy="11" r="8.5" />
    <path class={`n ${variant}`} d={BODY} />
  </g>
) : (
  <g transform={transform}>
    <path class={`n ${kind}`} d={BODY} />
    {face === "faded"
      ? <circle class={`n ${kind}`} cx="20" cy="11" r="8.5" style="fill-opacity:.3;stroke:var(--muted);stroke-dasharray:2 1.5" />
      : <circle class={`n ${kind}`} cx="20" cy="11" r="8.5" />}
    {/* generation marks (spec §3.1), from the mockup's companion/successor symbols: a star, and a chest band
        raised from y=34 to sit above the name scroll, which would otherwise cover it */}
    {kind === "tabii" && <path class="band" d="M10 25.6 L30 25.6" />}
    {face === "blank" && <circle cx="20" cy="11" r="4.5" style="fill:var(--hole)" />}
    {face === "mask" && (
      <>
        <path class="mask" d="M11.2 8 Q20 4.5 28.8 8 L27.8 13.6 Q20 16.2 12.2 13.6Z" />
        <circle class="maskeye" cx="16.5" cy="10.4" r="1.5" />
        <circle class="maskeye" cx="23.5" cy="10.4" r="1.5" />
      </>
    )}
    {/* the suspect's mask (phase 3 al-Mardūd design §1): the same outline, dashed, with no fill and no eyes, so it
        reads as suspected, not proven */}
    {face === "mask-dashed" && <path class="mask-dashed" d="M11.2 8 Q20 4.5 28.8 8 L27.8 13.6 Q20 16.2 12.2 13.6Z" />}
    {scroll === "yes" && (
      <g class="scroll">
        <rect x="11" y="29" width="18" height="7" rx="1.5" />
        <rect x="9.5" y="28" width="3" height="9" rx="1.5" />
        <rect x="27.5" y="28" width="3" height="9" rx="1.5" />
        <path d="M14 31.4h12M14 33.7h8" class="ink" />
      </g>
    )}
    {scroll === "slot" && <rect class="slot" x="9.5" y="28" width="21" height="9" rx="1.5" />}
    {seal === "yes" && (
      <g class="seal">
        <circle cx="31" cy="39" r="4.6" />
        <circle class="sealin" cx="31" cy="39" r="2.4" />
      </g>
    )}
    {seal === "slot" && <circle class="slot" cx="31" cy="39" r="4.6" />}
    {seal === "crack" && (
      <>
        <g class="seal"><circle cx="31" cy="39" r="4.6" /></g>
        <path class="crack" d="M28 35.5 L31.2 38.6 L29.6 40.4 L33.6 43" />
      </>
    )}
    {seal === "void" && (
      <>
        <g class="seal void"><circle cx="31" cy="39" r="4.6" /></g>
        <path class="cross" d="M28.4 36.4l5.2 5.2M33.6 36.4l-5.2 5.2" />
      </>
    )}
    {face === "hand" && (
      <>
        <path class="arm-o" d="M31 33 Q31 21 22 16" />
        <path class="arm" d="M31 33 Q31 21 22 16" />
        <ellipse class="hand" cx="20.5" cy="15.6" rx="4.6" ry="2.7" />
      </>
    )}
    {kind === "sahabi" && <path class="n sahabi star" d="M33 0 L34.6 3.4 L38 5 L34.6 6.6 L33 10 L31.4 6.6 L28 5 L31.4 3.4Z" />}
  </g>
)}
{label && <text class={`lbl mode-label${variant === "ghost" ? " gap" : ""}`} x={x} y={f(y + 22 * k + 14)}>{label}</text>}
<style>
  .n{stroke-width:1.5}
  .sahabi{fill:url(#gold);stroke:var(--gold-a)}
  .tabii{fill:var(--green);stroke:var(--green)}
  .later{fill:var(--ink);stroke:var(--ink-edge)}
  .band{stroke:var(--hole);stroke-width:3;fill:none}
  .star{stroke-width:.8;stroke-linejoin:round}
  .unborn{fill:none;stroke:var(--muted);stroke-dasharray:3 2.4}
  .ghost{fill:none;stroke:var(--gap);stroke-dasharray:4 3;animation:blink 2.4s ease-in-out infinite}
  .scroll rect{fill:var(--moon);stroke:var(--moon-ink);stroke-width:.8}
  .ink{stroke:var(--moon-ink);stroke-width:.9;fill:none;stroke-linecap:round}
  .seal circle{fill:var(--seal)} .seal .sealin{fill:none;stroke:var(--moon);stroke-width:.7;opacity:.7}
  .seal.void circle{fill:var(--muted)}
  .slot{fill:none;stroke:var(--muted);stroke-width:.9;stroke-dasharray:1.6 1.4;animation:blink 2.4s ease-in-out infinite}
  .crack{fill:none;stroke:var(--surface);stroke-width:1.2;stroke-linejoin:round}
  .cross{stroke:var(--gap);stroke-width:1.8;stroke-linecap:round}
  .mask{fill:var(--moon);stroke:var(--moon-ink);stroke-width:.6} .maskeye{fill:var(--ink)}
  .mask-dashed{fill:none;stroke:var(--moon);stroke-width:1.2;stroke-dasharray:2 1.4;stroke-linejoin:round}
  .hand{fill:var(--moon);stroke:var(--moon-ink);stroke-width:.6}
  .arm-o{fill:none;stroke:var(--surface);stroke-width:5.5;stroke-linecap:round} .arm{fill:none;stroke:var(--ink);stroke-width:3.5;stroke-linecap:round}
</style>
