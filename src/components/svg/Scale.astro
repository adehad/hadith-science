---
// a balance scale (phase 3 design §7): a stand, a beam pivoting at (x, y) and two pans with `left` / `right`
// weight discs, one per narrator. tilt is in degrees, CSS rotate (positive lowers the right pan).
// The beam's resting transform is the final tilt and the pans rest translated to the beam's ends, so they hang
// level; motion.css's `tip` keyframes animate both from level, once. With animations off (reduced motion) the
// scale simply rests tipped. crackLeft / crackRight crack that pan's discs, for a weak narrator.
// Decorative: the term triggers under the pans carry the meaning.
import { discRow, scaleEnds } from "../../lib/kit";
import { f } from "./geom";

interface Props {
  x: number;
  y: number;
  w: number;
  tilt: number;
  left: number;
  right: number;
  crackLeft?: boolean;
  crackRight?: boolean;
  /** string length from the beam down to the pan */
  drop?: number;
  /** stand height from the pivot down to the base */
  stand?: number;
}
const { x, y, w, tilt, left, right, crackLeft = false, crackRight = false, drop = 30, stand = 58 } = Astro.props;
const R = 6, GAP = 14, PW = 58;
const ends = scaleEnds(x, w, tilt);
const pans = [
  { ...ends.left, n: left, crack: crackLeft },
  { ...ends.right, n: right, crack: crackRight },
].map((p) => {
  const py = y + drop;
  return {
    dy: p.dy,
    strings: `M${p.x} ${y} L${f(p.x - PW / 2 + 4)} ${py} M${p.x} ${y} L${f(p.x + PW / 2 - 4)} ${py}`,
    dish: `M${f(p.x - PW / 2)} ${py} Q${p.x} ${py + 12} ${f(p.x + PW / 2)} ${py} Z`,
    discs: discRow(p.n, p.x, GAP).map((cx) => ({ cx, cy: py - R + 1 })),
    crack: p.crack,
  };
});
const origin = `transform-box:view-box;transform-origin:${x}px ${y}px`;
---
<g class="scale" aria-hidden="true">
  <path class="stand" d={`M${x} ${y} V${y + stand} M${x - 24} ${y + stand} H${x + 24}`} />
  {pans.map((p) => (
    <g class="pan" style={`transform:translateY(${p.dy}px)`}>
      <path class="string" d={p.strings} />
      {p.discs.map((d) => (
        <>
          <circle class="disc" cx={d.cx} cy={d.cy} r={R} />
          {p.crack && <path class="dcrack" d={`M${d.cx - 3} ${d.cy - 4} L${d.cx + 0.5} ${d.cy - 0.5} L${d.cx - 1} ${d.cy + 1.5} L${d.cx + 3} ${d.cy + 4.5}`} />}
        </>
      ))}
      <path class="dish" d={p.dish} />
    </g>
  ))}
  <g class="beam" style={`${origin};transform:rotate(${tilt}deg)`}>
    <line x1={x - w / 2} y1={y} x2={x + w / 2} y2={y} />
  </g>
  <circle class="pivot" cx={x} cy={y} r="4.5" />
</g>
<style>
  .stand{fill:none;stroke:var(--line);stroke-width:3;stroke-linecap:round}
  .beam line{stroke:var(--fg);stroke-width:3.5;stroke-linecap:round}
  .pivot{fill:var(--surface);stroke:var(--fg);stroke-width:2}
  .string{fill:none;stroke:var(--line);stroke-width:1}
  .dish{fill:var(--surface);stroke:var(--fg);stroke-width:1.6;stroke-linejoin:round}
  .disc{fill:var(--ink);stroke:var(--ink-edge);stroke-width:1}
  .dcrack{fill:none;stroke:var(--moon);stroke-width:1.3;stroke-linejoin:round}
  .beam,.pan{animation:tip 1.2s ease-out .4s both}
</style>
